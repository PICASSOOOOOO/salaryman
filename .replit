modules = ["nodejs-24", "postgresql-16"]

      [[artifacts]]
      id = "artifacts/api-server"

      [[artifacts]]
      id = "artifacts/interview-helper"

      [deployment]
      router = "application"
      deploymentTarget = "vm"

      [deployment.build]
      args = ["pnpm", "run", "build"]

      [deployment.run]
      args = ["node", "artifacts/api-server/dist/index.cjs"]

      [deployment.postBuild]
      args = ["bash", "-c", "pnpm --filter db run push"]
      env = { "CI" = "true" }

      [workflows]
      runButton = "Project"

      [agent]
      stack = "PNPM_WORKSPACE"
expertMode = true
      integrations = ["resend:1.0.0"]

      [postMerge]
      path = "scripts/post-merge.sh"
      timeoutMs = 20000

      [nix]
      channel = "stable-25_05"
    