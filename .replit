modules = ["nodejs-24", "javascript", "python-3.11", "postgresql-16"]

          [[artifacts]]
          id = "artifacts/api-server"

          [[artifacts]]
          id = "artifacts/interview-helper"

          [deployment]
          router = "application"
          deploymentTarget = "vm"

          [deployment.build]
          args = ["pnpm", "run", "build:prepublish"]

          [deployment.run]
          args = ["node", "artifacts/api-server/dist/index.cjs"]

          [workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "phone-system"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "phone-health"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-structure"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-health"

[[workflows.workflow]]
name = "phone-system"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:phone"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "phone-health"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PHONE_HEALTH_ALWAYS_EMAIL=0 pnpm --filter @workspace/api-server run health:phone"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-structure"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:api-structure"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-health"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run health:all"

[workflows.workflow.metadata]
isValidation = true

        [agent]
        stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["resend:1.0.0"]

          [postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

          [nix]
          channel = "stable-25_05"
packages = ["SDL2", "SDL2_image", "SDL2_mixer", "SDL2_ttf", "fontconfig", "freetype", "libjpeg", "libpng", "pkg-config", "portmidi"]

[userenv]

[userenv.shared]
DISCORD_GUILD_INVITE_URL = "https://discord.gg/uV9DBxPnS"
STRIPE_PRICE_CLAW_BOT = "price_1TiwLePuaB9oFoK5Jsj6npBQ"
