modules = ["nodejs-24", "javascript", "python-3.11", "postgresql-16"]

          [[artifacts]]
          id = "artifacts/api-server"

          [[artifacts]]
          id = "artifacts/interview-helper"

          [deployment]
          router = "application"
          deploymentTarget = "vm"

          [deployment.build]
          args = ["pnpm", "run", "build"]

          [deployment.run]
          args = ["node", "artifacts/api-server/dist/index.cjs"]

          [deployment.postBuild]
          args = ["pnpm", "--filter", "@workspace/db", "run", "push"]
          env = { "CI" = "true" }

          [workflows]
          runButton = "Project"

        [agent]
        stack = "PNPM_WORKSPACE"
expertMode = true
        integrations = ["resend:1.0.0"]

          [postMerge]
          path = "scripts/post-merge.sh"
          timeoutMs = 20000

          [nix]
          channel = "stable-25_05"

[userenv]

[userenv.shared]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 21129
externalPort = 3000

[[ports]]
localPort = 21130
externalPort = 3002
        