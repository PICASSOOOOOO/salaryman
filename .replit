STRIPE_PRICE_BOT_CLOSER_X = "price_1TiwLgPuaB9oFoK53MkNlV6y"
STRIPE_PRICE_BOT_RESOLVE_7 = "price_1TiwLhPuaB9oFoK51y2L0leh"
STRIPE_PRICE_BOT_INK_9 = "price_1TiwLhPuaB9oFoK5e4Pjse3i"
