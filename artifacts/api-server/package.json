{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=${PORT:-8080} NODE_ENV=development tsx ./src/index.ts",
    "build": "tsx ./build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:phone": "vitest run src/__tests__/twilio*.test.ts src/__tests__/phone.test.ts",
    "test:api-structure": "vitest run api-structure",
    "health:phone": "tsx ./src/scripts/phone-health-check.ts",
    "health:phone:daily": "PHONE_HEALTH_ALWAYS_EMAIL=1 tsx ./src/scripts/phone-health-check.ts",
    "health:all": "tsx ./src/scripts/connection-health-check.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.13",
    "@clerk/express": "^2.1.64",
    "@clerk/shared": "^4.30.2",
    "@google-cloud/storage": "^7.19.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cheerio": "^1.2.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "elevenlabs": "^1.59.0",
    "exceljs": "^4.4.0",
    "express": "^5",
    "express-session": "^1.19.0",
    "geoip-lite": "^2.0.2",
    "google-auth-library": "^10.6.2",
    "http-proxy-middleware": "^4.2.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "plaid": "^42.2.0",
    "playwright": "^1.60.0",
    "resend": "4.0.0",
    "stripe": "^20.4.1",
    "twilio": "^5.13.0",
    "undici": "^8.10.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/geoip-lite": "^1.4.4",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.3",
    "supertest": "^7.2.2",
    "tsx": "catalog:",
    "vitest": "^4.1.11"
  }
}
